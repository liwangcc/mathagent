# MathAgent environment example
# Copy this file to .env and fill real secrets.

HOST=127.0.0.1
PORT=8080

# Production CORS. Keep CORS_ALLOW_ALL=false and set your real frontend origin.
CORS_ALLOW_ALL=false
CORS_ORIGINS=https://math.example.com

# Required. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-hex-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=48

# Development helpers. Never enable DEV_MODE in production.
DEV_MODE=false
HERMES_ENABLED=true

# Teacher chat: the legacy intent mode, and Hermes' fallback when
# TEACHER_LLM_PROVIDER/_BASE_URL/_API_KEY/_MODEL are unset. Any OpenAI-compatible
# endpoint; the values below are examples. 识图 and reports use DashScope below.
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_API_KEY=your-llm-api-key
LLM_API_KEYS=
LLM_API_KEY_WEIGHTS=
LLM_KEY_CONCURRENCY=4
LLM_MODEL=mimo-v2.6-pro

# Template positioning + standard answers: qwen3.8-max on the Alibaba Token
# Plan (subscription, Standard tier). No RPM/TPM; only tier concurrency (3-4),
# lowered dynamically by the platform. The GPT_FALLBACK prefix is historical.
# Token Plan endpoint (host token-plan.cn-beijing.maas.aliyuncs.com); copy the
# full OpenAI-compatible base URL from the Bailian console.
OCR_TEMPLATE_GPT_FALLBACK_BASE_URL=
OCR_TEMPLATE_GPT_FALLBACK_API_KEY=
# Model request name sent to the provider (must start with "qwen"), e.g.
# qwen4-max-preview. Unset means qwen3.8-max; an empty value turns the route off.
OCR_TEMPLATE_GPT_FALLBACK_MODEL=qwen3.8-max
OCR_TEMPLATE_GPT_FALLBACK_HARD_IN_FLIGHT=4
# Thinking tier of the Max locator (page request and tiles) and of the Max
# solver (page request and shards): none/minimal/low/medium/high/xhigh/max.
# The defaults suit qwen4-max-preview; a deployment still on qwen3.8-max sets both to high.
OCR_TEMPLATE_LOCATOR_REASONING_EFFORT=low
OCR_TEMPLATE_SOLVER_REASONING_EFFORT=medium

# DashScope pay-as-you-go: qwen3.8-flash student OCR, template stages and /
# grading share these credentials and one model RPM/TPM/concurrency window.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-dashscope-api-key
# Leave empty. One key per responsibility: same-vendor keys share the per-IP rate limit,
# so a list adds failover, not capacity. Ask the provider for a higher quota instead.
DASHSCOPE_API_KEYS=
DASHSCOPE_API_KEY_WEIGHTS=
# Student OCR is pinned in code; stale DASHSCOPE_MODEL values are ignored.
# Per-batch dispatcher for long full-paper OCR responses. It may fill the
# shared work window; payload bytes and CPU preprocessing remain separate.
OCR_BATCH_DISPATCH_CONCURRENT=256
OCR_PREPROCESS_MODE=fast
OCR_PREPROCESS_MAX_EDGE=1920
OCR_ANSWER_PREPROCESS_MAX_EDGE=3072
# Blank-template local registration: SIFT uses this bounded working edge while
# stored templates and answer evidence keep the normal 2200px artifact edge.
OCR_TEMPLATE_FEATURE_MAX_EDGE=1280
OCR_TEMPLATE_FEATURE_NFEATURES=3000

# Shared model policy: qwen3.8-flash work window is capped at 256 (80% of
# the historical >=320 clean point); one teacher may fill idle capacity.
DASHSCOPE_GLOBAL_CONCURRENCY=256
MODEL_TEACHER_BASE_CONCURRENCY=30
MODEL_TEACHER_BURST_CONCURRENCY=256
MODEL_GLOBAL_RESERVE_CONCURRENCY=0

# PaddleOCR fallback.
OCR_LANG=ch
OCR_USE_GPU=True

# Database.
DATABASE_URL=sqlite:///mathagent.db

# Student recognition.
STUDENT_INFO_CONFIDENCE_THRESHOLD=0.7

# Upload limits (match config.py defaults; override if needed).
MAX_UPLOAD_FILE_SIZE=20971520
MAX_UPLOAD_FILES=50
MAX_UPLOAD_TOTAL_SIZE=209715200
# Data-import files (Excel/JSON rosters, scores, answers) single-file cap (10MB).
MAX_IMPORT_FILE_SIZE=10485760

# SMS provider.
# 短信登录总开关：没有阿里云短信账号时设为 0（Docker 部署默认 0），
# 登录页只留密码登录，老师由管理员在「系统设置 → 教师账号」里创建。
SMS_ENABLED=1
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=MathAgent
SMS_TEMPLATE_CODE=

# WeChat OAuth.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=

# Captcha.
# 图形验证码提供方：builtin（服务端算术题，默认，无需外部账号）/ aliyun / off
CAPTCHA_PROVIDER=builtin
CAPTCHA_APP_ID=
CAPTCHA_APP_KEY=
CAPTCHA_SCENE_CODE=
# 管理员首次启动的初始密码与登录账号（仅在建库时使用；之后重启不会覆盖）。
# 留空则自动生成 16 位随机密码并打印到 stdout / 写入 data/.first-run-password。
ADMIN_PHONE=13800000000
ADMIN_NAME=管理员
ADMIN_PASSWORD=
# 模型密钥主密钥（base64 的 32 字节）。留空则首次启动生成 data/.model_key_master，
# 之后固定复用；换掉主密钥会导致已保存的模型 Key 无法解密（按未配置处理）。
MODEL_KEY_MASTER=

# Fallback model pricing, RMB per million tokens.
DEFAULT_PRICE_IN=2.0
DEFAULT_PRICE_OUT=6.0

# Cross-worker coordinator.  Production must keep both backends on Redis;
# local Windows development without Redis may explicitly use `local`.
REDIS_URL=redis://127.0.0.1:6379/0
MODEL_LIMITER_BACKEND=redis
LLM_RATE_LIMITER_BACKEND=redis
# The lease can renew only until MAX_HOLD; it never becomes an infinite lock.
MODEL_LIMITER_LEASE_SECONDS=180
MODEL_LIMITER_MAX_HOLD_SECONDS=300
MODEL_LIMITER_ACQUIRE_TIMEOUT_SECONDS=30
MODEL_LIMITER_REDIS_OPERATION_TIMEOUT_SECONDS=5
LLM_RATE_LIMIT_WINDOW_SECONDS=60
LLM_RATE_LIMIT_MAX_CALLS=20

# Deployment / logging (the installed /etc/mathagent/gunicorn.conf.py).
LOG_LEVEL=INFO
GUNICORN_BIND=127.0.0.1:8080
# Keep 1 until production capacity tests explicitly approve gray rollout to 2.
GUNICORN_WORKERS=1
GUNICORN_LOG_LEVEL=info
