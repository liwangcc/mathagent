# MathAgent 生产环境配置模板
# 复制为 .env 并填入真实值
# 字段与 .env.example 保持一致；本文件给出生产推荐值。

# ═══════════════════════════════════════════════════════════════
# 基础配置
# ═══════════════════════════════════════════════════════════════
HOST=127.0.0.1
PORT=8080

# CORS 白名单（生产必填，逗号分隔）
CORS_ALLOW_ALL=false
CORS_ORIGINS=https://your-domain.com

# 开发开关：生产环境务必保持 false
DEV_MODE=false
# 自然语言助手（小M / Hermes）总开关
HERMES_ENABLED=true

# JWT 密钥（必填，至少32字符）
# 生成命令: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-here-at-least-32-chars
JWT_ALGORITHM=HS256
# token 有效期（小时）；生产建议 48
JWT_EXPIRE_HOURS=48

# ═══════════════════════════════════════════════════════════════
# 数据库
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=sqlite:///mathagent.db

# ═══════════════════════════════════════════════════════════════
# AI 模型配置
# ═══════════════════════════════════════════════════════════════

# OCR层 — Qwen 3.8 Flash（阿里云 DashScope，官方关闭思考组合）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key
# Leave empty. One key per responsibility: same-vendor keys share the per-IP rate limit,
# so a list adds failover, not capacity. Ask the provider for a higher quota instead.
DASHSCOPE_API_KEYS=
DASHSCOPE_API_KEY_WEIGHTS=
# 学生 OCR 模型由代码固定为 qwen3.8-flash；残留 DASHSCOPE_MODEL 不参与选路。

# 数学判分 — qwen3.8-flash（DashScope，代码固定路由）
# 与学生 OCR/模板分栏共用 DASHSCOPE_* 凭证、RPM/TPM 预算和共享并发窗。

# 教师聊天 — 关闭 Hermes 时的旧意图模式与 Hermes 回退线路（Hermes 优先读 TEACHER_LLM_*）。
# 任意 OpenAI 兼容端点，下列为示例值；识图与报告走上面的 DASHSCOPE_*。
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_API_KEY=your_llm_api_key
LLM_API_KEYS=your_llm_api_keys
LLM_API_KEY_WEIGHTS=
LLM_KEY_CONCURRENCY=4
LLM_MODEL=mimo-v2.6-pro

# 允许批次填满共享工作窗；图片字节预算和 CPU 预处理独立限制。
OCR_BATCH_DISPATCH_CONCURRENT=256
OCR_PREPROCESS_MODE=fast
OCR_PREPROCESS_MAX_EDGE=1920
OCR_ANSWER_PREPROCESS_MAX_EDGE=3072
# Blank-template local registration working set (do not lower without a
# page-matching load test; 1280/3000 is the validated 2-core baseline).
OCR_TEMPLATE_FEATURE_MAX_EDGE=1280
OCR_TEMPLATE_FEATURE_NFEATURES=3000

# Provider/teacher model policy (API key count does not change these limits).
# The shared qwen3.8-flash application work window is capped at 256; the
# environment may lower it but cannot restore the retired Plus window or 500.
DASHSCOPE_GLOBAL_CONCURRENCY=256
MODEL_TEACHER_BASE_CONCURRENCY=30
MODEL_TEACHER_BURST_CONCURRENCY=256
# Active DashScope route is work-conserving; reserve only exists for legacy generic callers.
MODEL_GLOBAL_RESERVE_CONCURRENCY=0

# PaddleOCR fallback
OCR_LANG=ch
OCR_USE_GPU=True

# 学生信息识别置信度阈值
STUDENT_INFO_CONFIDENCE_THRESHOLD=0.7

# ═══════════════════════════════════════════════════════════════
# 上传限制（与 config.py 默认值一致，按需覆盖）
# ═══════════════════════════════════════════════════════════════
MAX_UPLOAD_FILE_SIZE=20971520
MAX_UPLOAD_FILES=50
MAX_UPLOAD_TOTAL_SIZE=209715200
# 数据导入文件（名单/成绩/答案 Excel/JSON）单文件上限（10MB）
MAX_IMPORT_FILE_SIZE=10485760

# ═══════════════════════════════════════════════════════════════
# 第三方服务
# ═══════════════════════════════════════════════════════════════

# 阿里云短信
# 短信登录总开关：没有阿里云短信账号时设为 0（Docker 部署默认 0），
# 登录页只留密码登录，老师由管理员在「系统设置 → 教师账号」里创建。
SMS_ENABLED=1
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=MathAgent
SMS_TEMPLATE_CODE=

# 微信登录（可选）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=

# 阿里云图形验证码（可选）
# 图形验证码提供方：builtin（服务端算术题，默认，无需外部账号）/ aliyun / off
CAPTCHA_PROVIDER=builtin
CAPTCHA_APP_ID=
CAPTCHA_APP_KEY=
CAPTCHA_SCENE_CODE=
# 管理员首次启动的初始密码与登录账号（仅在建库时使用；之后重启不会覆盖）。
# 留空则自动生成 16 位随机密码并打印到 stdout / 写入 data/.first-run-password。
ADMIN_PHONE=13800000000
ADMIN_NAME=管理员
ADMIN_PASSWORD=
# 模型密钥主密钥（base64 的 32 字节）。留空则首次启动生成 data/.model_key_master，
# 之后固定复用；换掉主密钥会导致已保存的模型 Key 无法解密（按未配置处理）。
MODEL_KEY_MASTER=

# 兜底模型计价（人民币/百万token）
DEFAULT_PRICE_IN=2.0
DEFAULT_PRICE_OUT=6.0

# ═══════════════════════════════════════════════════════════════
# Redis 跨 worker 协调（生产必填；Redis 仅监听本机 loopback）
# ═══════════════════════════════════════════════════════════════
REDIS_URL=redis://127.0.0.1:6379/0
MODEL_LIMITER_BACKEND=redis
LLM_RATE_LIMITER_BACKEND=redis
# 租约最多续到 300 秒，到期后绝不再续，避免看门狗无限持锁。
MODEL_LIMITER_LEASE_SECONDS=180
MODEL_LIMITER_MAX_HOLD_SECONDS=300
MODEL_LIMITER_ACQUIRE_TIMEOUT_SECONDS=30
MODEL_LIMITER_REDIS_OPERATION_TIMEOUT_SECONDS=5
LLM_RATE_LIMIT_WINDOW_SECONDS=60
LLM_RATE_LIMIT_MAX_CALLS=20

# ═══════════════════════════════════════════════════════════════
# 部署 / 日志（唯一配置安装在 /etc/mathagent/gunicorn.conf.py）
# ═══════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
GUNICORN_BIND=127.0.0.1:8080
# 保持 1；仅在 Redis 与生产容量验收通过后，手工灰度改为 2。
GUNICORN_WORKERS=1
GUNICORN_LOG_LEVEL=info
