# MathAgent: Redis shared coordination (start with one Gunicorn worker)
# Copy these non-secret settings to /opt/mathagent/.env after Redis has been
# installed locally on the production server. Do not put API keys in this file.

# Redis is an in-host coordinator only; bind it to 127.0.0.1.
REDIS_URL=redis://127.0.0.1:6379/0
MODEL_LIMITER_BACKEND=redis
LLM_RATE_LIMITER_BACKEND=redis
# The watchdog may renew only inside this finite window; after 300 seconds the
# Redis lease is allowed to expire and a stuck request cannot retain capacity.
MODEL_LIMITER_LEASE_SECONDS=180
MODEL_LIMITER_MAX_HOLD_SECONDS=300
MODEL_LIMITER_ACQUIRE_TIMEOUT_SECONDS=30
MODEL_LIMITER_REDIS_OPERATION_TIMEOUT_SECONDS=5
LLM_RATE_LIMIT_WINDOW_SECONDS=60
LLM_RATE_LIMIT_MAX_CALLS=20

# Shared qwen3.8-flash work window; OCR, template Flash and grading use the
# same Redis model capacity. API keys do not add model quota.
DASHSCOPE_GLOBAL_CONCURRENCY=256
MODEL_TEACHER_BASE_CONCURRENCY=30
MODEL_TEACHER_BURST_CONCURRENCY=256
MODEL_GLOBAL_RESERVE_CONCURRENCY=0

# These are process-local safety windows, not all-server API limits. The
# default systemd unit selects the balanced 4 GiB profile; choose low_memory
# explicitly on a roughly 1.6 GiB host. Redis above remains the actual
# cross-worker/provider limit. Individual settings override the profile.
MATHAGENT_RESOURCE_PROFILE=standard
OCR_PREPROCESS_LOCAL_MAX_CONCURRENT=1
OCR_LOCAL_MAX_CONCURRENT=256
# Local dispatch width for one student batch; the shared Redis limiter is the
# provider cap, while image bytes and preprocessing remain separate.
OCR_BATCH_DISPATCH_CONCURRENT=256
OCR_IMAGE_PAYLOAD_MEMORY_BUDGET_BYTES=536870912

# Existing KeyPool / TaskQueue must not impose an API-key-based cap before Redis.
OCR_PER_TEACHER_LIMIT=256

# Max subscription coordinator (the historical prefix is retained).
# Student Flash batches refill continuously; teacher fairness is per-request
# in Redis. Legacy wave-size/active-teacher settings do not cap dispatch.
OCR_MULTI_POOL_COORDINATOR=redis

# Student paper OCR is qwen3.8-flash through DASHSCOPE_* with the official
# thinking-off pair. Template locating, solving and answer-sheet standard
# answers use qwen3.8-max on the Alibaba Token Plan; the GPT canonical/YS/
# exemption routes are retired.
# Provider credentials belong in the protected production environment, so the
# URL, key and model are intentionally absent from this example.
# Token Plan has no RPM/TPM; only the tier's in-flight limit applies (1-8).
OCR_TEMPLATE_GPT_FALLBACK_HARD_IN_FLIGHT=4
OCR_TEMPLATE_GPT_FALLBACK_ATTEMPT_TTL_S=480
OCR_TEMPLATE_GPT_FALLBACK_FIRST_EVENT_TIMEOUT_S=60

OCR_FINAL_GUARD_S=10
OCR_MAX_CROSS_POOL_RETRIES_PER_PAPER=1
OCR_MAX_AUTOMATIC_RETRIES_PER_BATCH=3
OCR_CONNECT_TIMEOUT_S=10
OCR_WRITE_TIMEOUT_S=90
OCR_SSE_IDLE_TIMEOUT_S=30
OCR_POOL_CIRCUIT_FAILURE_THRESHOLD=3
OCR_POOL_CIRCUIT_COOLDOWN_S=60
