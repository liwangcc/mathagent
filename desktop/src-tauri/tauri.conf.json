{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MathAgent",
  "version": "0.1.12",
  "identifier": "cn.mathagent.desktop",
  "build": {
    "beforeDevCommand": "npm run build:prepare",
    "beforeBuildCommand": "npm run build:prepare",
    "frontendDist": "../../frontend/dist-desktop"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://mathagent.com.cn"
    },
    "windows": [
      {
        "label": "main",
        "title": "MathAgent",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#f4f5f3",
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/mathagent-sidecar"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
